APP_NAME="E-commerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------
# Base de datos (MySQL, segun lo solicitado por la actividad)
# Crea antes la base de datos vacia, por ejemplo:
#   CREATE DATABASE ecommerce_api CHARACTER SET utf8mb4;
# ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# ---------------------------------------------------------
# JWT (tymon/jwt-auth) - se genera con: php artisan jwt:secret
# ---------------------------------------------------------
JWT_SECRET=
JWT_TTL=60

# ---------------------------------------------------------
# Stripe (modo de prueba / test mode)
# Obten tus llaves de prueba en https://dashboard.stripe.com/test/apikeys
# ---------------------------------------------------------
STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key

# ---------------------------------------------------------
# L5 Swagger (documentacion OpenAPI en /api/documentation)
# ---------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000
